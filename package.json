{
  "name": "autonomous-enterprise-resource-manager",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20"
  },
    "workspaces": [
    "apps/*",
    "packages/*",
    "arena"
  ],
  "scripts": {
    "dev:api": "bun run --filter @rm/api dev",
    "dev:web": "bun run --filter @rm/web dev",
    "dev:vendor-a": "bun run --filter @rm/vendor-a dev",
    "dev:vendor-b": "bun run --filter @rm/vendor-b dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arena:run": "bun run --filter @rm/arena run",
    "db:migrate": "bun run --filter @rm/api db:migrate",
    "db:seed": "bun run --filter @rm/api db:seed",
    "demo:reset": "bun run --filter @rm/api demo:reset"
  },
  "devDependencies": {
    "jsdoc": "^4.0.5"
  }
}