{
  "name": "autonomous-enterprise-resource-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "pnpm --filter @rm/api dev",
    "dev:web": "pnpm --filter @rm/web dev",
    "dev:vendor-a": "pnpm --filter @rm/vendor-a dev",
    "dev:vendor-b": "pnpm --filter @rm/vendor-b dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:channel3:live": "tsx scripts/test_live_channel3.ts",
    "test:llm": "tsx scripts/test_llm_key.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arena:run": "tsx arena/runner.ts",
    "db:migrate": "pnpm --filter @rm/api db:migrate",
    "db:seed": "pnpm --filter @rm/api db:seed",
    "demo:reset": "pnpm --filter @rm/api demo:reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}