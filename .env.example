# Copy to .env and fill in. Never commit .env. Sandbox credentials only.

# --- Runtime ---
NODE_ENV=development
PAYPAL_ENV=sandbox                  # services must refuse to start if this is not "sandbox"
API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
VENDOR_A_URL=http://localhost:3101
VENDOR_B_URL=http://localhost:3102
ML_SERVICE_URL=http://localhost:8000   # optional; api must work without it

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rm

# --- Auth between services and for sessions ---
SERVICE_TOKEN=change-me
SESSION_SECRET=change-me

# --- WebAuthn (passkeys) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# --- PayPal sandbox (one REST app per business account) ---
PAYPAL_COMPANY_CLIENT_ID=
PAYPAL_COMPANY_CLIENT_SECRET=
PAYPAL_VENDOR_A_CLIENT_ID=
PAYPAL_VENDOR_A_CLIENT_SECRET=
PAYPAL_VENDOR_B_CLIENT_ID=
PAYPAL_VENDOR_B_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Pricing benchmark ---
CHANNEL3_API_KEY=

# --- LLM (via Vercel AI SDK) ---
LLM_API_KEY=
LLM_MODEL=

# --- Render (used to trigger Workflows tasks) ---
RENDER_API_KEY=

# --- Arena ---
ARENA_ENABLED=true
ARENA_RATE_LIMIT_PER_MIN=10
